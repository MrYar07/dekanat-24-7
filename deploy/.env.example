# Скопируй в deploy/.env на сервере: cp .env.example .env && nano .env
# Файл .env в git не попадает и лежит только на сервере.

# Адрес сайта. Без своего домена: IP через дефисы + .sslip.io, например 203-0-113-5.sslip.io
SITE_ADDRESS=CHANGE_ME.sslip.io

# Пароль базы. Сгенерировать: openssl rand -hex 24 (только буквы и цифры, чтобы не ломать URL подключения)
POSTGRES_PASSWORD=CHANGE_ME

# Пароль всех тестовых аккаунтов (не короче 10 символов). Его ты укажешь в комментарии к конкурсной работе.
SEED_PASSWORD=CHANGE_ME_AT_LEAST_10

# Версия образа: latest или короткий хеш коммита для отката, например sha-88a28fe
APP_TAG=latest
